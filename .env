# Gemini API (from Google AI Studio)
# create your api key in https://console.cloud.google.com/agent-platform/studio/settings
GEMINI_API_KEY= # paste your api key there

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=daypilot

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# App
APP_ENV=development
APP_SECRET_KEY=daypilot_dev_secret
