# health-agent-migration — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Gemini API (free-tier local testing) ──────────────────────────────────────
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Google Cloud (production ADC path) ────────────────────────────────────────
# Set these when switching from API key to Application Default Credentials.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# ── Node 4 model override ──────────────────────────────────────────────────────
# gemini-2.5-flash   — faster, cheaper, good for testing
# gemini-2.5-pro     — slower, more capable, use for production
NODE4_MODEL=gemini-2.5-flash

# ── Memory backend ─────────────────────────────────────────────────────────────
# jsonl    — local JSONL files under memory/{user_id}/memory_log.jsonl (default)
# bigquery — production BigQuery backend (stub, not yet implemented)
MEMORY_BACKEND=jsonl

# ── HTTP server ─────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8001
