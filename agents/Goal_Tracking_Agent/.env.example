# MongoDB Atlas
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=goal_tracking

# Google / Gemini
GEMINI_API_KEY=your-gemini-api-key-here
GCP_PROJECT=your-gcp-project-id

# Downstream services
MEMORY_AGENT_URL=https://memory-agent-<hash>-uc.a.run.app
CALENDAR_SERVICE_ACCOUNT_JSON=/secrets/calendar-sa.json

# Feasibility
OVERLOAD_THRESHOLD_MINUTES=600

# Auth (shared secret with Coordinator Agent; leave empty to disable in dev)
API_BEARER_TOKEN=
